<!--
  Snippet: Foto de perfil profissional (Rafael)
  Estilo: consistente com a identidade visual do Cosma Psicologia
  - PT Serif (headings) / Inter (corpo) / IBM Plex Mono (dados)
  - Cores: tinta escura #1C2A2E, verde-azulado #2F5D50
  Instruções: copie o HTML para dentro da seção "sobre" do site,
  e o CSS para o arquivo de estilos (ou <style> existente).
  Coloque headshot.webp em /public/img/ (ou pasta de assets equivalente).
-->

<section class="profile-photo-wrap">
  <figure class="profile-photo">
    <img
      src="/img/headshot.webp"
      alt="Rafael, psicólogo — Cosma Psicologia"
      width="320"
      height="320"
      loading="lazy"
    />
  </figure>
</section>

<style>
  .profile-photo-wrap {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0;
  }

  .profile-photo {
    margin: 0;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid rgba(28, 42, 46, 0.15);
    box-shadow: 0 6px 20px rgba(28, 42, 46, 0.12);
    background: #f5f2ec;
  }

  .profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 768px) {
    .profile-photo {
      width: 240px;
      height: 240px;
    }
  }
</style>
